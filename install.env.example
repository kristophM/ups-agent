# ups-agent tunables. Copy to /etc/ups-agent/install.env on the rig (install.sh
# does this on first run) and re-run install.sh to apply changes.

# NUT name for the UPS (letters, digits, - and _ only) and a free-text label.
UPS_NAME=cyberpower
UPS_DESC="CyberPower UPS"

# Shut the OS down when EITHER threshold is crossed while on battery:
#   battery charge at or below this percent ...
CHARGE_LOW=40
#   ... or estimated runtime at or below this many seconds.
RUNTIME_LOW=180

# Backstop: shut down after this many consecutive seconds on battery,
# regardless of charge. Set high enough that a brief outage does not trip it.
ONBATT_SHUTDOWN_SECS=300

# After the OS halts: seconds until the UPS cuts its outlets. CyberPower
# firmware rounds this DOWN to a multiple of 60, so use 60, 120, ...
OFFDELAY=60
# Seconds (from the shutdown command) until the UPS restores its outlets.
# CyberPower behaviour, verified on a CP1000AVRLCDa:
#   * a positive value fires when the timer expires EVEN IF utility power is
#     still out, so the machine boots on battery;
#   * -1 (timer disabled) means the UPS never restarts on its own, not even
#     when utility power returns -- someone has to press its button.
# So the UPS is used as a periodic retry: every ONDELAY seconds it re-powers
# the outlets. If utility power is back, the machine boots and stays up. If
# not, the machine sees ON BATTERY right after boot and (see
# BOOT_GRACE_SECS) shuts down again within a couple of minutes, costing a
# few percent of charge per retry. Multiple of 60; must exceed OFFDELAY.
ONDELAY=1800

# If the machine boots and finds the UPS already on battery within this many
# seconds of boot, it is a retry into an ongoing outage: shut down again at
# once instead of waiting ONBATT_SHUTDOWN_SECS. 0 disables this.
BOOT_GRACE_SECS=180

# Heartbeat interval (minutes) for status.log while everything is normal.
HEARTBEAT_MIN=15
